{
  "name": "worms-revival",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wr/client",
    "build": "npm run build -w @wr/client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:determinism": "node tools/determinism/run.mjs",
    "art:ingest": "node tools/art/ingest.mjs",
    "art:review": "node tools/art/review.mjs",
    "art:test": "node --test tools/art/ingest.test.mjs tools/art/arsenal.test.mjs tools/art/vfx.test.mjs tools/art/military.test.mjs",
    "art:arsenal": "node tools/art/arsenal.mjs",
    "art:vfx": "node tools/art/vfx.mjs",
    "art:military": "node tools/art/military.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
